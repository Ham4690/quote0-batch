# quote0-batch の環境変数テンプレート。
# 値を埋めて .env にコピーする(.env は .gitignore 対象・コミット禁止)。
# CI では GitHub Actions Secrets から注入する。

# quote/0 Text API の Bearer トークン(秘匿)
DOT_API_KEY=

# デバイスのシリアルナンバー(秘匿・推測/列挙対策)
SERIAL_NUM=

# API ベース URL(任意・未設定なら既定値 https://dot.mindreset.tech を使用)
DOT_BASE_URL=

# --- 天気連携(M3)。すべて非秘匿・CI では GitHub Actions Variables から注入 ---

# 天気 API の地点コード(任意・未設定なら既定値 130010=東京)
CITY_CODE=

# 天気 API ベース URL(任意・未設定なら既定値 https://weather.tsukumijima.net)
WEATHER_BASE_URL=

# 表示タップ時の遷移先 URL(任意・未設定なら API レスポンスの link=気象庁へフォールバック)
# CITY_CODE を変えたら対応する Yahoo 天気ページ URL を設定する
WEATHER_LINK_URL=
